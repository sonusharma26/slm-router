# Copy only the values you need to .env.local or export them in your shell.
# Never commit local environment files.
OPENROUTER_API_KEY=""
# NVIDIA Build is used only by examples/nvidia-live/. Keep this in .env.local or your shell, never commit it.
NVIDIA_API_KEY=""
# Required to start the router service; use an independent random value of 24+ characters.
SLM_ROUTER_API_KEY=""
SLM_REQUESTS_PER_SECOND=4.0
SLM_CONFIG_PATH=configs/config.yaml
SLM_MODELS_PATH=configs/models.yaml
SLM_CACHE_DIR=.cache
SLM_OBS_ENABLED=false
